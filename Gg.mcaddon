.animate-\[bounce_1s_infinite\] { animation: 1s ease 0s infinite normal none running bounce; }

.animate-\[bounce_1s_infinite_-100ms\] { animation: 1s ease -0.1s infinite normal none running bounce; }

.animate-\[bounce_1s_infinite_-200ms\] { animation: 1s ease -0.2s infinite normal none running bounce; }

@keyframes bounce { 
  0%, 100% { transform: translateY(-25%); animation-timing-function: cubic-bezier(0.8, 0, 1, 1); }
  50% { transform: none; animation-timing-function: cubic-bezier(0, 0, 0.2, 1); }
}

.animate-bounce { animation: 1s ease 0s infinite normal none running bounce; }

@keyframes caret-blink { 
  0%, 70%, 100% { opacity: 1; }
  20%, 50% { opacity: 0; }
}

.animate-caret-blink { animation: 1.25s ease-out 0s infinite normal none running caret-blink; }

@keyframes ping { 
  75%, 100% { transform: scale(2); opacity: 0; }
}

.animate-ping { animation: 1s cubic-bezier(0, 0, 0.2, 1) 0s infinite normal none running ping; }

@keyframes pulse { 
  50% { opacity: 0.5; }
}

.animate-pulse { animation: 2s cubic-bezier(0.4, 0, 0.6, 1) 0s infinite normal none running pulse; }

@keyframes shake { 
  10%, 90% { transform: translate(-4px); }
  20%, 80% { transform: translate(4px); }
  30%, 70% { transform: translate(-4px); }
  40%, 60% { transform: translate(4px); }
  50% { transform: translate(-4px); }
}

.animate-shake { animation: 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) 0s 1 normal both running shake; }

@keyframes spin { 
