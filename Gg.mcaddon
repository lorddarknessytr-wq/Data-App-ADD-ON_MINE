@charset "utf-8";

@font-face { font-family: "Yekan Bakh"; font-style: normal; font-weight: 100; src: url("woff/YekanBakh-thin.woff") format("woff"), url("woff2/YekanBakh-thin.woff2") format("woff2"); }

@font-face { font-family: "Yekan Bakh"; font-style: normal; font-weight: 300; src: url("woff/YekanBakh-Light.woff") format("woff"), url("woff2/YekanBakh-Light.woff2") format("woff2"); }

@font-face { font-family: "Yekan Bakh"; font-style: normal; font-weight: normal; src: url("woff/YekanBakh-Regular.woff") format("woff"), url("woff2/YekanBakh-Regular.woff2") format("woff2"); }

@font-face { font-family: "Yekan Bakh"; font-style: normal; font-weight: 600; src: url("woff/YekanBakh-SemiBold.woff") format("woff"), url("woff2/YekanBakh-SemiBold.woff2") format("woff2"); }

@font-face { font-family: "Yekan Bakh"; font-style: normal; font-weight: bold; src: url("woff/YekanBakh-Bold.woff") format("woff"), url("woff2/YekanBakh-Bold.woff2") format("woff2"); }

@font-face { font-family: "Yekan Bakh"; font-style: normal; font-weight: 800; src: url("woff/YekanBakh-ExtraBold.woff") format("woff"), url("woff2/YekanBakh-ExtraBold.woff2") format("woff2"); }

@font-face { font-family: "Yekan Bakh"; font-style: normal; font-weight: 900; src: url("woff/YekanBakh-Black.woff") format("woff"), url("woff2/YekanBakh-Black.woff2") format("woff2"); }

@font-face { font-family: "Yekan Bakh"; font-style: normal; font-weight: 950; src: url("woff/YekanBakh-ExtraBlack.woff") format("woff"), url("woff2/YekanBakh-ExtraBlack.woff2") format("woff2"); }
------MultipartBoundary--Pq8He7ZAZLrtGf6nGGN87dRY1LgKFOTxvkxhBDRNQ0----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://my.files.ir/build/assets/drive-routes-DoDbGsK6.css

@charset "utf-8";

@supports (container-type: inline-size) {
  .shareable-link-grid-container { container-type: inline-size; }
  .shareable-link-grid { display: grid; gap: 1.125rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  @container (min-width: 450px) {
  .shareable-link-grid { display: grid; gap: 1.125rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
}
  @container (min-width: 550px) {
  .shareable-link-grid { display: grid; gap: 1.125rem; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); }
}
  @container (min-width: 800px) {
  .shareable-link-grid { display: grid; gap: 1.125rem; grid-template-columns: repeat(auto-fill, minmax(380px, 2fr)); }
}
  @container (min-width: 1040px) {
  .shareable-link-grid { display: grid; gap: 1.125rem; grid-template-columns: repeat(auto-fill, minmax(510px, 2fr)); }
}
}

@supports not (container-type: inline-size) {
  .shareable-link-grid { display: grid; gap: 0.875rem; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  @media (min-width: 768px) {
  .shareable-link-grid { display: grid; gap: 1.125rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); }
}
  @media (min-width: 1024px) {
  .shareable-link-grid { display: grid; gap: 1.125rem; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); }
}
}
------MultipartBoundary--Pq8He7ZAZLrtGf6nGGN87dRY1LgKFOTxvkxhBDRNQ0----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://my.files.ir/build/assets/main-DoxWaUqT.css

@charset "utf-8";

@font-face { font-family: YekanBakh; font-style: normal; src: url("./YekanBakh-VF-DNd82k7q.woff") format("woff"), url("./YekanBakh-VF-BlbtQSxx.woff2") format("woff2"); }

.progress-circle { overflow: hidden; }

.progress-circle.indeterminate { animation: 0.8s ease 0s infinite normal none running spinner-spin; }

.progress-circle .progress-circle-track { height: 100%; stroke: rgb(var(--be-foreground-base) / var(--be-divider-opacity)); }

.progress-circle .progress-circle-fill { height: 100%; stroke: rgb(var(--progress-circle-fill-color, var(--be-primary))); transition: 0.5s cubic-bezier(0.4, 0, 0.2, 1); }

@keyframes spinner-spin { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

.be-top-progress-bar { position: fixed; top: 0px; left: 0px; height: 3px; background: rgb(var(--be-primary-light)); z-index: 2147483647; transition: width 0.3s ease-out, opacity 0.15s ease-in 0.15s; transform: translateZ(0px); }

.skeleton::before { content: "Â "; }

.skeleton-wave { animation: 2s ease-in-out 0s infinite normal none running skeleton-wave; background-size: 200px 100%; background-image: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.6), rgba(255, 255, 255, 0)); }

.dark .skeleton-wave { background-image: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0)); }

.skeleton-pulsate { animation: 1.5s ease-in-out 0.5s infinite normal none running skeleton-pulsate; }

@keyframes skeleton-wave { 
  0% { background-position: -200px 0px; }
  100% { background-position: calc(100% + 200px) 0px; }
}

@keyframes skeleton-pulsate { 
  0% { opacity: 1; }
  50% { opacity: 0.4; }
  100% { opacity: 1; }
}

.dashboard-grid { display: grid; grid-template: "navbar navbar navbar" "sidenav-left header header" "sidenav-left content sidenav-right" 1fr / auto 1fr auto; }

.dashboard-grid-content { grid-area: content; position: relative; }

.dashboard-grid-header { grid-area: header; }

.dashboard-grid-navbar { grid-area: navbar; }

.dashboard-grid-sidenav-left { grid-area: sidenav-left; }

.dashboard-grid-sidenav-right { grid-area: sidenav-right; }

.dashboard-grid-footer { grid-area: content; align-self: end; width: 100%; }

.ProseMirror { min-height: inherit; outline: transparent solid 2px; outline-offset: 2px; }

.ProseMirror img.ProseMirror-selectednode, .ProseMirror iframe.ProseMirror-selectednode { border-radius: 0.25rem; --tw-ring-opacity: 1; --tw-ring-color: rgb(var(--be-primary-light) / var(--tw-ring-opacity, 1)); }

.prose [data-indent="1"] { padding-left: 1.25rem; }

.prose [data-indent="2"] { padding-left: 2.5rem; }

.prose [data-indent="3"] { padding-left: 3.75rem; }

.prose [data-indent="4"] { padding-left: 5rem; }

.prose [data-indent="5"] { padding-left: 6.25rem; }

.prose [data-indent="6"] { padding-left: 8rem; }

.prose iframe { aspect-ratio: 16 / 9; width: 100%; }

.info-block { margin-top: 2rem; margin-bottom: 2rem; max-width: 100%; overflow-wrap: break-word; border-radius: 0.5rem; border-left-width: 0.25rem; --tw-border-opacity: 1; border-left-color: rgb(34 197 94 / var(--tw-border-opacity, 1)); background-color: rgb(34 197 94 / var(--be-hover-opacity)); padding: 0.875rem; font-size: 1rem; line-height: 1.5rem; }

.info-block .title { font-size: 1rem; line-height: 1.5rem; font-weight: 500; --tw-text-opacity: 1; color: rgb(67 72 77 / var(--tw-text-opacity, 1)); }

.info-block.important { --tw-border-opacity: 1; border-left-color: rgb(243 164 50 / var(--tw-border-opacity, 1)); background-color: rgb(243 164 50 / var(--be-hover-opacity)); }

.info-block.warning { --tw-border-opacity: 1; border-left-color: rgb(239 68 68 / var(--tw-border-opacity, 1)); background-color: rgb(239 68 68 / var(--be-hover-opacity)); }

.info-block p { margin-top: 0.375rem; margin-bottom: 0px; }

.ad-host:empty { display: none; }

.ad-host > :not(img) { height: 100%; max-height: 600px; }

.ad-host img { margin: auto; }

.image-file-color { color: rgb(244, 67, 54); }

.audio-file-color { color: rgb(255, 152, 0); }

.video-file-color { color: rgb(244, 67, 54); }

.text-file-color { color: rgb(33, 150, 243); }

.default-file-color { color: rgb(117, 117, 117); }

.folder-file-color, .shared-folder-file-color, .archive-file-color { color: rgb(251, 192, 45); }

.pdf-file-color { color: rgb(244, 67, 54); }

.power-point-file-color { color: rgb(245, 127, 23); }

.word-file-color { color: rgb(33, 150, 243); }

.spreadsheet-file-color { color: rgb(0, 137, 123); }

.player-bottom-gradient { background-image: linear-gradient(to top, rgba(0, 0, 0, 0.5), 10%, transparent, 95%, rgba(0, 0, 0, 0.3)); }

.player-bottom-text-shadow { text-shadow: rgba(0, 0, 0, 0.5) 0px 0px 2px; }

.custom-page-body p:empty::before { content: ""; display: inline-block; }

.dark ::-webkit-scrollbar, .dark::-webkit-scrollbar { max-height: 10px; max-width: 10px; width: auto; }

.dark ::-webkit-scrollbar-corner, .dark::-webkit-scrollbar-corner, .dark ::-webkit-scrollbar-track, .dark::-webkit-scrollbar-track { background: rgb(42, 42, 42); }

.dark ::-webkit-scrollbar-thumb, .dark::-webkit-scrollbar-thumb { background: rgb(90, 90, 90); border: 1px solid rgb(42, 42, 42); border-radius: 10px; }

.dark, .dark * { scrollbar-color: rgb(90, 90, 90) rgb(42, 42, 42); }

* { scrollbar-width: thin; }

.dark .compact-scrollbar::-webkit-scrollbar-thumb { background: rgb(90, 90, 90); }

.compact-scrollbar::-webkit-scrollbar { max-height: 6px; max-width: 6px; width: auto; }

.compact-scrollbar::-webkit-scrollbar-corner, .compact-scrollbar::-webkit-scrollbar-track { background: transparent; }

.compact-scrollbar::-webkit-scrollbar-thumb { background: rgb(193, 193, 193); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; border-radius: 10px; }

.compact-scrollbar { scrollbar-width: thin; scrollbar-color: rgb(193, 193, 193) transparent; }

.hidden-scrollbar { scrollbar-width: none; }

